+static void
+iap_request_encoding(void)
+{
+  GoodixIapVersion payload = {
+    .length = 25,
+    .reserved = 0
+  };
+
+  const guint8 expected_protocol[] = {
+    0xf6, 0x03, 0x00, 0x19, 0x00, 0x98
+  };
+
+  const guint8 expected_packet[] = {
+    0xa0, 0x06, 0x00, 0xa6,
+    0xf6, 0x03, 0x00, 0x19, 0x00, 0x98
+  };
+
+  g_autofree guint8 *protocol = NULL;
+  g_autofree guint8 *packet = NULL;
+  guint32 protocol_size = 0;
+  guint32 packet_size = 0;
+
+  goodix_encode_protocol(
+    GOODIX_CMD_GET_IAP_VERSION,
+    (guint8 *) &payload,
+    sizeof(payload),
+    TRUE,
+    FALSE,
+    &protocol,
+    &protocol_size
+  );
+
+  g_assert_cmpuint(protocol_size, ==, sizeof(expected_protocol));
+  g_assert_cmpmem(protocol, protocol_size,
+                  expected_protocol, sizeof(expected_protocol));
+
+  goodix_encode_pack(
+    GOODIX_FLAGS_MSG_PROTOCOL,
+    protocol,
+    protocol_size,
+    TRUE,
+    &packet,
+    &packet_size
+  );
+
+  g_assert_cmpuint(packet_size, ==, GOODIX_EP_OUT_MAX_BUF_SIZE);
+  g_assert_cmpmem(packet, sizeof(expected_packet),
+                  expected_packet, sizeof(expected_packet));
+
+  for (guint32 i = sizeof(expected_packet); i < packet_size; i++)
+    g_assert_cmpuint(packet[i], ==, 0);
+}
+
+typedef struct
+{
+  gboolean called;
+  const gchar *expected_version;
+  gboolean expect_error;
+} IapTestResult;
+
+static void
+iap_test_callback(FpDevice *dev,
+                  gchar *version,
+                  gpointer user_data,
+                  GError *error)
+{
+  IapTestResult *result = user_data;
+
+  result->called = TRUE;
+  g_assert_cmpint(error != NULL, ==, result->expect_error);
+
+  if (result->expect_error)
+    {
+      g_assert_error(error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+      g_clear_error(&error);
+    }
+  else
+    {
+      g_assert_no_error(error);
+      g_assert_cmpstr(version, ==, result->expected_version);
+    }
+}
+
+static void
+test_iap_response(const guint8 *data,
+                  guint16 length,
+                  const gchar *expected_version,
+                  gboolean expect_error)
+{
+  IapTestResult result = {
+    .called = FALSE,
+    .expected_version = expected_version,
+    .expect_error = expect_error
+  };
+
+  GoodixCallbackInfo *cb_info = g_new0(GoodixCallbackInfo, 1);
+  cb_info->callback = G_CALLBACK(iap_test_callback);
+  cb_info->user_data = &result;
+
+  goodix_receive_iap_version(NULL, (guint8 *) data, length,
+                             cb_info, NULL);
+
+  g_assert_true(result.called);
+}
+
+static void
+iap_response_valid(void)
+{
+  const guint8 response[25] = "MILAN_RTSEC_IAP_10027";
+
+  test_iap_response(response, sizeof(response),
+                    "MILAN_RTSEC_IAP_10027", FALSE);
+}
+
+static void
+iap_response_too_short(void)
+{
+  const guint8 response[24] = { 'A' };
+
+  test_iap_response(response, sizeof(response), NULL, TRUE);
+}
+
+static void
+iap_response_empty(void)
+{
+  const guint8 response[25] = { 0 };
+
+  test_iap_response(response, sizeof(response), NULL, TRUE);
+}
+
+static void
+iap_response_invalid_utf8(void)
+{
+  guint8 response[25] = { 0xff };
+
+  test_iap_response(response, sizeof(response), NULL, TRUE);
+}
