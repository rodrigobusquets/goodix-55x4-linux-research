@@ -288,6 +288,58 @@ goodix_receive_firmware_version (FpDevice *dev, guint8 *data,
   callback (dev, payload, cb_info->user_data, NULL);
 }
 
+void
+goodix_receive_iap_version (FpDevice *dev, guint8 *data,
+                            guint16 length, gpointer user_data,
+                            GError *error)
+{
+  g_autofree GoodixCallbackInfo *cb_info = user_data;
+  GoodixFirmwareVersionCallback callback =
+    (GoodixFirmwareVersionCallback) cb_info->callback;
+  g_autofree gchar *version = NULL;
+  gsize version_length;
+  guint8 *terminator;
+
+  if (error)
+    {
+      callback (dev, NULL, cb_info->user_data, error);
+      return;
+    }
+
+  if (!data || length < 25 || length > 256)
+    {
+      g_set_error (&error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                   "Invalid IAP version response length: %d", length);
+      callback (dev, NULL, cb_info->user_data, error);
+      return;
+    }
+
+  terminator = memchr (data, 0x00, length);
+  version_length = terminator ? (gsize) (terminator - data) : length;
+
+  if (version_length == 0)
+    {
+      g_set_error (&error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                   "Empty IAP version response");
+      callback (dev, NULL, cb_info->user_data, error);
+      return;
+    }
+
+  version = g_malloc (version_length + 1);
+  memcpy (version, data, version_length);
+  version[version_length] = '\0';
+
+  if (!g_utf8_validate (version, -1, NULL))
+    {
+      g_set_error (&error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                   "IAP version response is not valid UTF-8");
+      callback (dev, NULL, cb_info->user_data, error);
+      return;
+    }
+
+  callback (dev, version, cb_info->user_data, NULL);
+}
+
 void
 goodix_receive_ack (FpDevice *dev, guint8 *data, guint16 length,
                     gpointer user_data, GError *error)
@@ -1159,6 +1211,36 @@ goodix_send_firmware_version (FpDevice                     *dev,
                         NULL);
 }
 
+void
+goodix_send_iap_version (FpDevice                     *dev,
+                         GoodixFirmwareVersionCallback callback,
+                         gpointer                      user_data)
+{
+  GoodixIapVersion payload = {
+    .length = 25,
+    .reserved = 0
+  };
+  GoodixCallbackInfo *cb_info;
+
+  if (callback)
+    {
+      cb_info = malloc (sizeof (GoodixCallbackInfo));
+
+      cb_info->callback = G_CALLBACK (callback);
+      cb_info->user_data = user_data;
+
+      goodix_send_protocol (dev, GOODIX_CMD_GET_IAP_VERSION,
+                            (guint8 *) &payload, sizeof (payload),
+                            NULL, TRUE, GOODIX_TIMEOUT, TRUE,
+                            goodix_receive_iap_version, cb_info);
+      return;
+    }
+
+  goodix_send_protocol (dev, GOODIX_CMD_GET_IAP_VERSION,
+                        (guint8 *) &payload, sizeof (payload),
+                        NULL, TRUE, GOODIX_TIMEOUT, TRUE, NULL, NULL);
+}
